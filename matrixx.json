{
  "$schema": "https://raw.githubusercontent.com/klpanagi/matrixx/dev/assets/matrixx.schema.json",
  "agents": {
    // T1 — Frontier (Claude Opus 4.6) — orchestration, precision, writing
    "morpheus":    { "model": "google-vertex-anthropic/claude-opus-4-6@default" },
    "oracle":      { "model": "google-vertex-anthropic/claude-opus-4-6@default" },
    "keymaker":    { "model": "google-vertex-anthropic/claude-opus-4-6@default" },
    "cipher":      { "model": "google-vertex-anthropic/claude-opus-4-6@default" },
    "niobe":       { "model": "google-vertex-anthropic/claude-opus-4-6@default" },
    // T2 — Reasoning (Gemini 3.1 Pro) — review, architecture, debugging
    "merovingian": { "model": "google-vertex/gemini-3.1-pro-preview" },
    "smith":       { "model": "google-vertex/gemini-3.1-pro-preview" },
    // T3 — Balanced
    "seraph":      { "model": "google-vertex-anthropic/claude-sonnet-4-6@default" },
    "architect":   { "model": "google-vertex/gemini-3-flash-preview" },
    "construct":   { "model": "google-vertex/gemini-3-flash-preview" },
    // T4 — Speed (Gemini 2.5 Flash) — grep, docs, search
    "trinity":     { "model": "google-vertex/gemini-2.5-flash" },
    "operator":    { "model": "google-vertex/gemini-2.5-flash" }
  },
  "categories": {
    // T1 — Opus for hard logic + DSL precision
    "source":          { "model": "google-vertex-anthropic/claude-opus-4-6@default" },
    "dsl-engineering": { "model": "google-vertex-anthropic/claude-opus-4-6@default" },
    // T2 — Gemini 3.1 Pro for autonomous reasoning + creative
    "deep-jack":    { "model": "google-vertex/gemini-3.1-pro-preview" },
    "matrix-bend":  { "model": "google-vertex/gemini-3.1-pro-preview" },
    "construct":    { "model": "google-vertex/gemini-3.1-pro-preview" },
    "red-pill":     { "model": "google-vertex/gemini-3.1-pro-preview" },
    // T3 — Sonnet for moderate effort, Flash for docs
    "blue-pill":    { "model": "google-vertex-anthropic/claude-sonnet-4-6@default" },
    "broadcast":    { "model": "google-vertex/gemini-3-flash-preview" },
    // T4 — Flash for trivial
    "bullet-time":  { "model": "google-vertex/gemini-2.5-flash" }
  }
}

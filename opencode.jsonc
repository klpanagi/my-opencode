{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": "notify",
	"plugin": [
		"/home/klpanagi/matrixx",
		"@tarquinen/opencode-dcp",
		"@nick-vi/opencode-type-inject",
		"envsitter-guard",
		"@ccusage/opencode",
		"@slkiser/opencode-quota"
	],
	// ─── PROVIDERS ─────────────────────────────────────────────────────────────
	"provider": {
		"ariadne-staging": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ariadne Staging",
			"options": {
				"baseURL": "https://beta.ariadne.issel-portal.com/api/v1",
				"apiKey": "{env:ARIADNE_STAGING_API_KEY}"
			},
			"models": {
				"claude-haiku-4-5@20251001": {
					"name": "Claude Haiku 4-5"
				},
				"Qwen/Qwen3.5-35B-A3B": {
					"name": "Qwen 3.5 35B"
				}
			}
		}
	}
}

{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": "notify",
	"lsp": true,
	// "model": "commandcode/deepseek/deepseek-v4-flash",
	"plugin": [
		// "/home/klpanagi/scholia",
		"/home/klpanagi/matrixx",
		"@tarquinen/opencode-dcp@latest",
		"@nick-vi/opencode-type-inject@latest",
		"envsitter-guard@latest",
		// "@slkiser/opencode-quota@latest",
		"context-mode@latest",
		"opencode-mem@latest",
		"opencode-plugin-auto-update@latest"
	],
	"provider": {
		"ollama": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama",
			"options": {
				"baseURL": "http://localhost:11434/v1"
			},
			"models": {
				"hhao/qwen2.5-coder-tools:3b": {
					"tools": true,
					"toolChoice": "auto",
					"name": "Local Gwen 2.5 Coder"
				}
			}
		},
		"ariadne-staging": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ariadne Staging",
			"options": {
				"baseURL": "https://ariadne.issel.ee.auth.gr/api/v1",
				"apiKey": "{env:ARIADNE_STAGING_API_KEY}"
			},
			"models": {
				"claude-haiku-4-5@20251001": {
					"name": "Claude Haiku 4-5"
				},
				"Qwen/Qwen3.5-35B-A3B": {
					"name": "Qwen 3.5 35B"
				}
			}
		},
		"byteplus-plan": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "BytePlus Coding Plan",
			"options": {
				// Dedicated Coding Plan subscription endpoint
				"baseURL": "https://ark.ap-southeast.bytepluses.com/api/coding/v3",
				"apiKey": "{env:BYTEPLUS_CODING_KEY}"
			},
			"models": {
				// -----------------------------------------------------------------
				// 1. DYNAMIC AUTO / ROUTING MODEL
				// -----------------------------------------------------------------
				"ark-code-latest": {
					"name": "ark-code-latest",
					"limit": {
						"context": 256000,
						"output": 32000
					}
				},
				// -----------------------------------------------------------------
				// 2. BYTEDANCE / DOLA SEED NATIVE MODELS
				// -----------------------------------------------------------------
				"dola-seed-2.0-pro": {
					"name": "dola-seed-2.0-pro",
					"limit": {
						"context": 256000,
						"output": 32000
					}
				},
				"dola-seed-2.0-lite": {
					"name": "dola-seed-2.0-lite",
					"limit": {
						"context": 128000,
						"output": 16000
					}
				},
				"dola-seed-2.0-code": {
					"name": "dola-seed-2.0-code",
					"limit": {
						"context": 256000,
						"output": 32000
					}
				},
				"bytedance-seed-code": {
					"name": "bytedance-seed-code",
					"limit": {
						"context": 128000,
						"output": 16000
					}
				},
				// -----------------------------------------------------------------
				// 3. DEEPSEEK MODELS
				// -----------------------------------------------------------------
				"deepseek-v4-flash": {
					"name": "deepseek-v4-flash",
					"limit": {
						// "context": 1024000,
						"context": 256000,
						// "output": 384000,
						"output": 32000
					}
				},
				"deepseek-v4-pro": {
					"name": "deepseek-v4-pro",
					"limit": {
						"context": 1024000,
						"output": 384000
					}
				},
				// -----------------------------------------------------------------
				// 4. TSINGHUA GLM SERIES
				// -----------------------------------------------------------------
				"glm-5.2": {
					"name": "glm-5.2",
					"limit": {
						"context": 1000000,
						"output": 32000
					}
				},
				"glm-5.1": {
					"name": "glm-5.1",
					"limit": {
						"context": 1000000,
						"output": 32000
					}
				},
				// -----------------------------------------------------------------
				// 5. MOONSHOT KIMI & OPEN SOURCE FRONTIER
				// -----------------------------------------------------------------
				"kimi-k2.5": {
					"name": "kimi-k2.5",
					"limit": {
						"context": 256000,
						"output": 32000
					}
				},
				"gpt-oss-120b": {
					"name": "gpt-oss-120b",
					"limit": {
						"context": 128000,
						"output": 16000
					}
				}
			}
		},

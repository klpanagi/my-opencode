{
	"$schema": "https://raw.githubusercontent.com/klpanagi/matrixx/dev/assets/matrixx.schema.json",
	// Entry agent for new sessions.
	"default_run_agent": "morpheus",
	// Agent + category parameters live in matrixx.agents.jsonc (see agents_file).
	// Inline agents/categories below are deprecated overrides (inline wins per name).
	"agents_file": "matrixx.agents.jsonc",
	// Per-subscription model maps live in matrixx.presets.jsonc (see model_presets_file).
	"model_presets_file": "matrixx.presets.jsonc",
	// Preview features: auto session resume, early compaction, safe hook/plugin setup.
	"experimental": {
		"hashline_edit": true,
		"auto_resume": true,
		"preemptive_compaction": true,
		"safe_hook_creation": true
	},
	// Autonomous iterate-until-done loop (cap iterations, state dir for resume).
	"matrix_loop": {
		"enabled": true,
		"default_max_iterations": 100,
		"state_dir": ".opencode/"
	},
	// Parallel subagent limits: concurrency, staleness timeouts, circuit breaker.
	"background_task": {
		"defaultConcurrency": 8,
		"messageStalenessTimeoutMs": 120000,
		"staleTimeoutMs": 180000,
		"circuitBreaker": {
			"enabled": true,
			"maxToolCalls": 75,
			"consecutiveThreshold": 10
		}
	},
	// File-backed task system (T-{uuid}.json files); survives restarts.
	// NOTE: `scope` and `session_scoped` are different axes, not the same thing:
	// `scope` = WHERE task files live on disk; `session_scoped` = WHICH tasks
	// the continuation enforcer considers (own session's vs. all in the store).
	"tasks": {
		// Storage location: "project" → .matrixx/tasks/ in the repo (default),
		// "global" → shared <opencode-config>/tasks/{listId}.
		"scope": "project",
		// Max wait for blocking task() calls in ms (default: 600000 = 10 min,
		// min: 60000). Raise for agents that delegate to subagents (e.g. Oracle→Seraph).
		"pollTimeoutMs": 900000,
		// Pending tasks with no file activity for this many hours are stale and
		// excluded from continuation nudges (default: 24, min: 0.25 = 15 min).
		"stale_after_hours": 24,
		// Same idea, but ONLY for background-agent completion gates: a pending task
		// idle this long stops blocking its background handle (default: 2). Kept
		// separate because a missed nudge vs. a wedged handle are different failures.
		"background_stale_after_hours": 2,
		// Visibility filter for the continuation enforcer: true → only tasks created
		// by the current session (or its subagents); false → all tasks in the store
		// regardless of session origin (default: true).
		"session_scoped": true
	},
	// Plan files (.matrixx/plans/*.md): size cap and Oracle review rounds.
	"plans": {
		// Max bytes for a single plan file (default: 140000, min: 10240, max: 524288).
		"max_plan_file_bytes": 140000,
		// Ceiling on Smith review rounds in Oracle high-accuracy mode (default: 8, min: 2, max: 20).
		"smith_max_review_rounds": 8
	},
	// Test-first enforcement: failing test before implementation, never delete failing tests.
	"tdd_enforcer": {
		"enabled": true
	},
	// Engine used by browser-automation skills.
	"browser_automation_engine": {
		"provider": "playwright"
	},
	// Multi-model voting: independent voters x synthesis rounds (bias reduction for big calls).
	"assembly": {
		"enabled": true,
		"providers": [
			{
				"providerID": "opencode-go",
				"modelID": "deepseek-v4-flash"
			},
			{
				"providerID": "opencode-go",
				"modelID": "deepseek-v4-flash"
			}
		],
		"default_voters": 3,
		"default_rounds": 2,
		"timeout_ms": 60000
	},
	// Tool registration gating. session_cleanup deletes leaked sessions, so it
	// is opt-in — flip to false (or remove the key) once the backlog is cleared.
	"tool_gating": {
		"session_cleanup": true
	},
	"security": {},
	// Provider failover on retryable errors (429/5xx): attempts, cooldown, notify.
	"runtime_fallback": {
		"enabled": true,
		"retry_on_errors": [
			429,
			500,
			502,
			503,
			504
		],
		"max_fallback_attempts": 3,
		"cooldown_seconds": 60,
		"timeout_seconds": 30,
		"notify_on_fallback": true
	},
	// Allow the plugin to propose its own config tuning (proactive = unprompted).
	"matrixx_self_config": {
		"enabled": true,
		"proactive": false
	},
	// Helper CLI used by the plugin for system tasks.
	"rtk": {
		"enabled": true,
		"binary_path": "/home/klpanagi/.local/bin/rtk",
		"timeout_ms": 5000
	},
	// External knowledge hubs (read-only KB routing).
	// - Router index (_index.md, truncated to ~6000 tokens) is injected once per session with the
	//   directive: consult hubs before websearch/webfetch, open files via @hub/path on demand, never bulk-read.
	// - Guard: hub roots are read-only for Write/Edit/destructive Bash unless the target matches `exclude`.
	// - Missing `knowledge` = fail-open (nothing injected, writes allowed).
	"knowledge": {
		"hubs": [
			{
				// Hub handle: reference files as @kb/<relative-path> or hub:kb/<relative-path>.
				"name": "kb",
				// Hub root: `~`/`~/` expands to home,
				"path": "/home/klpanagi/Dropbox/_knowledge",
				// Router file, relative to path. Default "_index.md".
				"index": "_index.md",
				// "global" = shared KB (all projects) | "project" = repo-local. Default "global".
				"scope": "global",
				// "router-only" (default) = inject index only; check index first, then read single files on demand, never bulk-read.
				// "pinned" = router-only + also inject pinned files upfront (extra context, costs tokens).
				"mode": "router-only"
				// Optional: "exclude": ["scratch/**"] — extra picomatch patterns merged over DEFAULT_KNOWLEDGE_EXCLUDES
				// (.*, *.env, *.docx, *.pptx, *.zip, node_modules/**, .publisync_env, .alz_mongo_env); matched paths stay writable.
			}
		]
	},
	// DCP profile switcher. Per-profile overrides live under dcp.profiles.<name>
	// (built-ins: brutal/economy/balanced/performance/ultimate). default_profile
	// applies on bare switch. The live dcp.jsonc is GENERATED from this block
	// on every switch — don't hand-edit that file.
	"dcp": {
		"enabled": true,
		"default_profile": "brutal",
		"profiles": {
			"brutal": {
				"autoUpdate": false,
				"debug": false,
				// Notification display: "off", "minimal", or "detailed"
				"pruneNotification": "minimal",
				"pruneNotificationType": "chat",
				"commands": {
					"enabled": true
				},
				"compress": {
					"mode": "range",
					"permission": "allow",
					"showCompression": true,
					"maxContextLimit": "20%",
					"minContextLimit": "10%",
					"nudgeFrequency": 1,
					"iterationNudgeThreshold": 3,
					"summaryBuffer": true,
					"nudgeForce": "strong",
					"protectedTools": [],
					"protectUserMessages": false
				},
				"strategies": {
					"deduplication": {
						"enabled": true,
						"protectedTools": []
					},
					"purgeErrors": {
						"enabled": true,
						"turns": 2,
						"protectedTools": []
					}
				},
				"manualMode": {
					"enabled": false,
					"automaticStrategies": true
				},
				"protectedFilePatterns": [],
				"experimental": {
					"allowSubAgents": false
				}
			},
			// Test-only profile: forces min-band proactive compress to fire early
			// (max 10% / min 5% — far more aggressive than brutal 20%/10%).
			// Use for live TUI verification, then remove or keep disabled.
			"min-band-test": {
				"pruneNotification": "detailed",
				"compress": {
					"maxContextLimit": "10%",
					"minContextLimit": "5%",
					"nudgeFrequency": 1,
					"nudgeForce": "strong",
					"iterationNudgeThreshold": 1
				},
				"turnProtection": {
					"enabled": false
				},
				"experimental": {
					"allowSubAgents": false
				},
				"strategies": {
					"purgeErrors": {
						"turns": 1
					}
				}
			}
		},
		// Matrixx-side hard enforcement of the DCP ceiling: above abovePercent,
		// prepend an explicit "compress the largest closed span, reach targetPercent"
		// directive to the tail of the last user message (tail-only, cache-safe).
		"watchdog": {
			"enabled": true,
			"abovePercent": 20,
			"targetPercent": 15,
			"cooldownTurns": 2,
			// Keyword trigger: inject the same compress directive when a keyword
			// appears in the last user message (shares watchdog cooldown + marker).
			"keywordTrigger": {
				"enabled": true,
				"keywords": [
					"dcp-compress",
					"compress context",
					"run dcp"
				]
			}
		},
		// Handoff-boundary compression for background agent results.
		// When enabled, background agent session messages > maxMessages are
		// truncated to keepFirst + keepLast before being returned to the parent.
		"handoffCompression": {
			"enabled": true,
			"maxMessages": 6,
			"keepFirst": 2,
			"keepLast": 3
		},
	},
	// Tools hidden from the model (paired with context_mode enforcement below).
	// "disabled_tools": [
	// 	"grep",
	// 	"glob",
	// 	"read",
	// 	"edit"
	// ],
	// Hard block on raw grep/glob/webfetch (+ fetch-shaped bash): use ctx_* tools instead (saves context).
	// Note: "read" is warn-only by design (blocking it would deadlock the Read+Edit plan flow);
	// "edit"/"write" are not valid here (schema enum: read, grep, glob, bash, webfetch).
	"context_mode": {
		"enabled": true,
		"enforce": true,
		"blocked_tools": [
			"grep",
			"glob",
			"webfetch",
			"read",
			"bash"
		]
	},
	// Session memory backend selector (off|native|lcm|supermemory, default off).
	// One backend at a time — lcm/supermemory force native OFF even if native.enabled is true.
	// - off: nothing runs, native hook not created.
	// - native: built-in JSONL hook (memory.native.*). Requires native.enabled=true.
	// - lcm: upstream opencode-lcm plugin, 18 lcm_* tools, SQLite/FTS5, pin 84103cca.
	//   BROKEN 2026-10-26 on opencode v2.1.4: opencode-lcm 0.15.1 exports old function
	//   format, loader expects definePlugin({id,setup}) — "no lcm_* tools are registered".
	//   Keep commented until upstream ships a v2-compatible release.
	// - supermemory: supermemory_recall + supermemory.jsonc + SUPERMEMORY_API_KEY,
	//   package opencode-supermemory@latest.
	// Missing-plugin warning when backend=lcm/supermemory but no tools detected (fail-open on empty catalog).
	// Double-capture warning when lcm_*/supermemory* tools observed while backend=native.
	"memory": {
		"backend": "native",
		"native": {
			"enabled": true,
			"ignoreToolPrefixes": [
				"ctx_"
			],
			"scopeDefaults": {
				"grep": "session",
				"describe": "session"
			},
			"scopeProfiles": [],
			"retention": {
				"deletedSessionDays": 30,
				"orphanBlobDays": 14
			},
			"perMessageBudget": 110,
			"automaticRetrieval": {
				"maxChars": 900,
				"minTokens": 2,
				"maxMessageHits": 2,
				"maxSummaryHits": 1,
				"maxArtifactHits": 1,
				"budgets": {
					"session": 16,
					"root": 12,
					"worktree": 8,
					"all": 6
				}
			},
			"compactContextLimit": 1200,
			"systemHint": true
		}
		// Alternatives (pick one, keep the rest commented):
		// { "backend": "off" }
		// { "backend": "lcm" } // + "opencode-lcm@latest" in opencode.jsonc plugins[] — BROKEN on opencode v2.1.4, see above
		// { "backend": "supermemory" } // + supermemory.jsonc + SUPERMEMORY_API_KEY + opencode-supermemory@latest
		// Flat alias (deprecated, still honored with one-time warning): { "enabled": true } -> native
	},
	// Applied config migrations. Managed by the plugin — don't touch.
	"_migrations": [
		"tasks_project_scope_default"
	],
	// Live preset selection. Restart the session after changing.
	// "active_preset": "commandcode-default"
	"active_preset": "opencode-default"
	// "active_preset": "cline-spark"
}

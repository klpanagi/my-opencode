{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": "notify",
	"lsp": true,
	"formatter": true,
	"instructions": [
		"/home/klpanagi/.config/opencode/ctx-rtk-discipline.md"
	],
	"model": "commandcode/deepseek/deepseek-v4-flash",
	"plugins": [
		"/home/klpanagi/Development/opencode-matrixx-2/dist",
		"@nick-vi/opencode-type-inject@latest",
		"envsitter-guard@latest",
		"opencode-cmd-provider@latest",
		"@tarquinen/opencode-dcp@latest",
		// "opencode-lcm@latest"
	],
	// V2 permissions are an ordered rule list where the LAST matching rule WINS.
	// Broad rules go FIRST, narrow exceptions LAST. A specific rule placed before
	// a catch-all is silently overridden.
	//
	// Shell commands are checked against `external_directory` (their working dir
	// plus any scanner-inferred paths) BEFORE their `shell` rule, so a late
	// `external_directory: "*" -> ask` re-introduces a prompt on every command
	// that touches a path outside the project. Both catch-alls below are `allow`
	// and sit last so nothing overrides them.
	"permissions": [
		{
			"action": "edit",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "webfetch",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "external_directory",
			"resource": "*",
			"effect": "allow"
		}
	],
	"providers": {
		"ollama": {
			"package": "@ai-sdk/openai-compatible",
			"name": "Ollama",
			"settings": {
				"baseURL": "http://localhost:11434/v1"
			},
			"models": {
				"hhao/qwen2.5-coder-tools:3b": {
					"tools": true,
					"toolChoice": "auto",
					"name": "Local Gwen 2.5 Coder"
				}
			}
		},
		"ariadne-staging": {
			"package": "@ai-sdk/openai-compatible",
			"name": "Ariadne Staging",
			"settings": {
				"baseURL": "https://ariadne.issel.ee.auth.gr/api/v1"
			},
			"env": [
				"ARIADNE_STAGING_API_KEY"
			],
			"models": {
				"claude-haiku-4-5@20251001": {
					"name": "Claude Haiku 4-5"
				},
				"Qwen/Qwen3.5-35B-A3B": {
					"name": "Qwen 3.5 35B"
				}
			}
		},
	},
	"mcp": {
		"servers": {
			"context-mode": {
				"type": "local",
				"command": [
					"context-mode"
				]
			}
		}
	}
}

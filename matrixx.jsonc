{
	"$schema": "https://raw.githubusercontent.com/klpanagi/matrixx/dev/assets/matrixx.schema.json",
	// Entry agent for new sessions.
	"default_run_agent": "morpheus",
	// Per-agent overrides (temperature, thinking budgets in output tokens, failover chains).
	// Model selection lives in model_presets below, not here.
	"agents": {
		"morpheus": {
			"temperature": 0.1,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 32000
			},
			"fallbackChain": [
				{
					"providers": [
						"opencode-go"
					],
					"model": "deepseek-v4-flash"
				}
			]
		},
		"oracle": {
			"temperature": 0.1,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 16000
			},
			"fallbackChain": [
				{
					"providers": [
						"opencode-go"
					],
					"model": "deepseek-v4-flash"
				}
			]
		},
		"seraph": {
			"temperature": 0.3,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 16000
			}
		},
		"keymaker": {
			"temperature": 0.1,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 16000
			},
			"fallbackChain": [
				{
					"providers": [
						"opencode-go"
					],
					"model": "deepseek-v4-flash"
				}
			]
		},
		"cipher": {
			"temperature": 0.1
		},
		"sentinel": {
			"temperature": 0.1,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 16000
			},
			"fallbackChain": [
				{
					"providers": [
						"opencode-go"
					],
					"model": "deepseek-v4-flash"
				}
			]
		},
		"smith": {
			"temperature": 0.1,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 16000
			}
		},
		"merovingian": {
			"temperature": 0.1
		},
		"architect": {
			"temperature": 0.1
		},
		"mouse": {
			"temperature": 0.1,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 8000
			}
		},
		"operator": {
			"temperature": 0.1,
			"permission": {
				"bash": "ask"
			}
		},
		"trinity": {
			"temperature": 0.1,
			"permission": {
				"bash": "ask"
			}
		},
		"construct": {
			"temperature": 0.1,
			"permission": {
				"bash": "ask"
			}
		},
		"sati": {
			"temperature": 0.1
		}
	},
	// Delegation tiers used by task(category=...). complexity_downgrades route
	// trivial work to cheap models (note: still reference the retired opencode-go provider).
	"categories": {
		"source": {
			"temperature": 0.1,
			"complexity_downgrades": {
				"1": "opencode-go/deepseek-v4-flash",
				"2": "opencode-go/deepseek-v4-flash"
			}
		},
		"deep-jack": {
			"temperature": 0.1
		},
		"red-pill": {
			"temperature": 0.1,
			"complexity_downgrades": {
				"1": "opencode-go/deepseek-v4-flash",
				"2": "opencode-go/deepseek-v4-flash"
			}
		},
		"construct": {
			"temperature": 0.1
		},
		"matrix-bend": {
			"temperature": 0.1
		},
		"blue-pill": {
			"temperature": 0.1
		},
		"broadcast": {
			"temperature": 0.1
		},
		"bullet-time": {
			"temperature": 0.1
		}
	},
	// Preview features: auto session resume, early compaction, safe hook/plugin setup.
	"experimental": {
		"hashline_edit": true,
		"auto_resume": true,
		"preemptive_compaction": true,
		"safe_hook_creation": true
	},
	// Autonomous iterate-until-done loop (cap iterations, state dir for resume).
	"matrix_loop": {
		"enabled": true,
		"default_max_iterations": 100,
		"state_dir": ".opencode/"
	},
	// Parallel subagent limits: concurrency, staleness timeouts, circuit breaker.
	"background_task": {
		"defaultConcurrency": 8,
		"messageStalenessTimeoutMs": 120000,
		"staleTimeoutMs": 180000,
		"circuitBreaker": {
			"enabled": true,
			"maxToolCalls": 75,
			"consecutiveThreshold": 10
		}
	},
	// File-backed task system (.matrixx/tasks/); project-scoped, survives restarts.
	"tasks": {
		"enabled": true,
		"scope": "project",
		"pollTimeoutMs": 900000
	},
	// Test-first enforcement: failing test before implementation, never delete failing tests.
	"tdd_enforcer": {
		"enabled": true
	},
	// Engine used by browser-automation skills.
	"browser_automation_engine": {
		"provider": "playwright"
	},
	// Multi-model voting: independent voters x synthesis rounds (bias reduction for big calls).
	"assembly": {
		"enabled": true,
		"providers": [
			{
				"providerID": "opencode-go",
				"modelID": "deepseek-v4-flash"
			},
			{
				"providerID": "opencode-go",
				"modelID": "deepseek-v4-flash"
			}
		],
		"default_voters": 3,
		"default_rounds": 2,
		"timeout_ms": 60000
	},
	"security": {},
	// Provider failover on retryable errors (429/5xx): attempts, cooldown, notify.
	"runtime_fallback": {
		"enabled": true,
		"retry_on_errors": [
			429,
			500,
			502,
			503,
			504
		],
		"max_fallback_attempts": 3,
		"cooldown_seconds": 60,
		"timeout_seconds": 30,
		"notify_on_fallback": true
	},
	// Allow the plugin to propose its own config tuning (proactive = unprompted).
	"matrixx_self_config": {
		"enabled": true,
		"proactive": false
	},
	// Helper CLI used by the plugin for system tasks.
	"rtk": {
		"enabled": true,
		"binary_path": "/home/klpanagi/.local/bin/rtk",
		"timeout_ms": 5000
	},
	// DCP profile switcher. base = shared mechanics (kept across tiers); profiles =
	// aggressiveness dial (built-ins: economy/balanced/performance/ultimate, extendable
	// via dcp.profiles.<name>). default_profile applies on bare switch. The live
	// dcp.jsonc is GENERATED from this block on every switch — don't hand-edit that file.
	"dcp": {
		"enabled": true,
		"default_profile": "economy",
		"base": {
			"autoUpdate": false,
			"debug": false,
			"pruneNotificationType": "chat",
			"compress": {
				"mode": "range",
				"permission": "allow",
				"showCompression": true,
				"summaryBuffer": true,
				"nudgeForce": "strong",
				"iterationNudgeThreshold": 5,
				"protectedTools": [],
				"protectUserMessages": false
			},
			"strategies": {
				"deduplication": {
					"enabled": true,
					"protectedTools": []
				},
				"purgeErrors": {
					"enabled": true,
					"protectedTools": []
				}
			},
			"commands": {
				"enabled": true,
				"protectedTools": []
			},
			"manualMode": {
				"enabled": false,
				"automaticStrategies": true
			},
			"protectedFilePatterns": []
		}
	},
	// Tools hidden from the model (paired with context_mode enforcement below).
	"disabled_tools": [
		"grep",
		"glob",
		"read",
		"edit"
	],
	// Hard block on raw grep/glob/read/edit: use ctx_* tools instead (saves context).
	"context_mode": {
		"enabled": true,
		"enforce": true,
		"blocked_tools": [
			"grep",
			"glob",
			"read",
			"edit"
		]
	},
	// Applied config migrations. Managed by the plugin — don't touch.
	"_migrations": [
		"tasks_project_scope_default"
	],
	// Per-subscription model maps: default_model + per-agent/per-category pins.
	// opencode-go/byteplus presets are stale (retired providers) — kept as reference.
	"model_presets": {
		"opencode-go": {
			"default_model": "opencode-go/deepseek-v4-flash",

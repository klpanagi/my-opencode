{
	"$schema": "https://raw.githubusercontent.com/klpanagi/matrixx/dev/assets/matrixx.schema.json",
	// Entry agent for new sessions.
	"default_run_agent": "morpheus",
	// Per-agent overrides (temperature, thinking budgets in output tokens, failover chains).
	// Model selection lives in model_presets below, not here.
	"agents": {
		"morpheus": {
			"variant": "low",
			"temperature": 0.1,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 32000
			},
			// "fallbackChain": [
			// 	{
			// 		"providers": [
			// 			"opencode-go"
			// 		],
			// 		"model": "deepseek-v4-flash"
			// 	}
			// ]
		},
		"oracle": {
			"variant": "low",
			"temperature": 0.1,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 16000
			},
		},
		"seraph": {
			"variant": "low",
			"temperature": 0.3,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 16000
			}
		},
		"keymaker": {
			"variant": "low",
			"temperature": 0.1,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 16000
			},
		},
		"cipher": {
			"variant": "low",
			"temperature": 0.1
		},
		"sentinel": {
			"variant": "low",
			"temperature": 0.1,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 16000
			},
		},
		"smith": {
			"variant": "low",
			"temperature": 0.1,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 16000
			}
		},
		"merovingian": {
			"variant": "low",
			"temperature": 0.1
		},
		"architect": {
			"variant": "low",
			"temperature": 0.1
		},
		"mouse": {
			"variant": "low",
			"temperature": 0.1,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 8000
			}
		},
		"operator": {
			"variant": "low",
			"temperature": 0.1,
			"permission": {
				"bash": "ask"
			}
		},
		"trinity": {
			"variant": "low",
			"temperature": 0.1,
			"permission": {
				"bash": "ask"
			}
		},
		"construct": {
			"variant": "low",
			"temperature": 0.1,
			"permission": {
				"bash": "ask"
			}
		},
		"sati": {
			"variant": "low",
			"temperature": 0.1
		}
	},
	// Delegation tiers used by task(category=...). complexity_downgrades route
	// trivial work to cheap models (note: still reference the retired opencode-go provider).
	"categories": {
		// Heavy reasoning — thinking ON with generous budget
		"source": {
			"variant": "low",
			"temperature": 0.1,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 32000
			},
			// "complexity_downgrades": {
			// 	"1": "opencode-go/deepseek-v4-flash",
			// 	"2": "opencode-go/deepseek-v4-flash"
			// }
		},
		"deep-jack": {
			"variant": "low",
			"temperature": 0.1,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 32000
			}
		},
		"matrix-bend": {
			"variant": "low",
			"temperature": 0.1,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 32000
			}
		},
		// Moderate reasoning
		"red-pill": {
			"variant": "low",
			"temperature": 0.1,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 16000
			},
		},
		"construct": {
			"variant": "low",
			"temperature": 0.1,
			"thinking": {
				"type": "enabled",
				"budgetTokens": 16000
			}
		},
		// Thinking OFF — simple/cheap tasks
		"blue-pill": {
			"variant": "low",
			"temperature": 0.1,
			"thinking": {
				"type": "disabled"
			}
		},
		"broadcast": {
			"variant": "low",
			"temperature": 0.1,
			"thinking": {
				"type": "disabled"
			}
		},
		"bullet-time": {
			"variant": "low",
			"temperature": 0.1,
			"thinking": {
				"type": "disabled"
			}
		}
	},
	// Preview features: auto session resume, early compaction, safe hook/plugin setup.
	"experimental": {
		"hashline_edit": true,
		"auto_resume": true,
		"preemptive_compaction": true,
		"safe_hook_creation": true
	},
	// Autonomous iterate-until-done loop (cap iterations, state dir for resume).
	"matrix_loop": {
		"enabled": true,
		"default_max_iterations": 100,
		"state_dir": ".opencode/"
	},
	// Parallel subagent limits: concurrency, staleness timeouts, circuit breaker.
	"background_task": {
		"defaultConcurrency": 8,
		"messageStalenessTimeoutMs": 120000,
		"staleTimeoutMs": 180000,
		"circuitBreaker": {
			"enabled": true,
			"maxToolCalls": 75,
			"consecutiveThreshold": 10
		}
	},
	// File-backed task system (.matrixx/tasks/); project-scoped, survives restarts.
	"tasks": {
		"enabled": true,
		"scope": "project",
		"pollTimeoutMs": 900000
	},
	// Test-first enforcement: failing test before implementation, never delete failing tests.
	"tdd_enforcer": {
		"enabled": true
	},
	// Engine used by browser-automation skills.
	"browser_automation_engine": {
		"provider": "playwright"
	},
	// Multi-model voting: independent voters x synthesis rounds (bias reduction for big calls).
	"assembly": {
		"enabled": true,
		"providers": [
			{
				"providerID": "opencode-go",
				"modelID": "deepseek-v4-flash"
			},
			{
				"providerID": "opencode-go",
				"modelID": "deepseek-v4-flash"
			}
		],
		"default_voters": 3,
		"default_rounds": 2,
		"timeout_ms": 60000
	},
	"security": {},
	// Provider failover on retryable errors (429/5xx): attempts, cooldown, notify.
	"runtime_fallback": {
		"enabled": true,
		"retry_on_errors": [
			429,
			500,
			502,
			503,
			504
		],
		"max_fallback_attempts": 3,
		"cooldown_seconds": 60,
		"timeout_seconds": 30,
		"notify_on_fallback": true
	},
	// Allow the plugin to propose its own config tuning (proactive = unprompted).
	"matrixx_self_config": {
		"enabled": true,
		"proactive": false
	},
	// Helper CLI used by the plugin for system tasks.
	"rtk": {
		"enabled": true,
		"binary_path": "/home/klpanagi/.local/bin/rtk",
		"timeout_ms": 5000
	},
	// External knowledge hubs (read-only KB routing).
	// - Router index (_index.md, truncated to ~6000 tokens) is injected once per session with the
	//   directive: consult hubs before websearch/webfetch, open files via @hub/path on demand, never bulk-read.
	// - Guard: hub roots are read-only for Write/Edit/destructive Bash unless the target matches `exclude`.
	// - Missing `knowledge` = fail-open (nothing injected, writes allowed).
	"knowledge": {
		"hubs": [
			{
				// Hub handle: reference files as @kb/<relative-path> or hub:kb/<relative-path>.
				"name": "kb",
				// Hub root: `~`/`~/` expands to home,
				"path": "/home/klpanagi/Dropbox/_knowledge",
				// Router file, relative to path. Default "_index.md".
				"index": "_index.md",
				// "global" = shared KB (all projects) | "project" = repo-local. Default "global".
				"scope": "global",
				// "router-only" (default) = inject index only; check index first, then read single files on demand, never bulk-read.
				// "pinned" = router-only + also inject pinned files upfront (extra context, costs tokens).
				"mode": "router-only"
				// Optional: "exclude": ["scratch/**"] — extra picomatch patterns merged over DEFAULT_KNOWLEDGE_EXCLUDES
				// (.*, *.env, *.docx, *.pptx, *.zip, node_modules/**, .publisync_env, .alz_mongo_env); matched paths stay writable.
			}
		]
	},
	// DCP profile switcher. base = shared mechanics (kept across tiers); profiles =
	// aggressiveness dial (built-ins: brutal/economy/balanced/performance/ultimate, extendable
	// via dcp.profiles.<name>). default_profile applies on bare switch. The live
	// dcp.jsonc is GENERATED from this block on every switch — don't hand-edit that file.
	"dcp": {
		"enabled": true,
		"default_profile": "brutal",
		"base": {
			"autoUpdate": false,
			"debug": false,
			"pruneNotificationType": "toast",
			"commands": {
				"enabled": true
			},
			"compress": {
				"mode": "range",
				"permission": "allow",
				"showCompression": true,
				"summaryBuffer": true,
				"nudgeForce": "strong",
				"iterationNudgeThreshold": 1,
				"protectedTools": [],
				"protectUserMessages": false
			},
			"strategies": {
				"deduplication": {
					"enabled": true,
					"protectedTools": []
				},
				"purgeErrors": {
					"enabled": true,
					"protectedTools": []
				}
			},
			"manualMode": {
				"enabled": false,
				"automaticStrategies": true
			},
			"protectedFilePatterns": [],
			"experimental": {
				"allowSubAgents": false
			}
		},
		"profiles": {
			// Test-only profile: forces min-band proactive compress to fire early
			// (max 10% / min 5% — far more aggressive than brutal 20%/10%).
			// Use for live TUI verification, then remove or keep disabled.
			"min-band-test": {
				"pruneNotification": "detailed",
				"compress": {
					"maxContextLimit": "10%",
					"minContextLimit": "5%",
					"nudgeFrequency": 1,
					"nudgeForce": "strong",
					"iterationNudgeThreshold": 1
				},
				"turnProtection": {
					"enabled": false
				},
				"experimental": {
					"allowSubAgents": false
				},
				"strategies": {
					"purgeErrors": {
						"turns": 1
					}
				}
			}
		},
		// Handoff-boundary compression for background agent results.
		// When enabled, background agent session messages > maxMessages are
		// truncated to keepFirst + keepLast before being returned to the parent.
		"handoffCompression": {
			"enabled": true,
			"maxMessages": 6,
			"keepFirst": 2,
			"keepLast": 3
		},
	},
	// Tools hidden from the model (paired with context_mode enforcement below).
	"disabled_tools": [
		"grep",
		"glob",
		"read",
		"edit"
	],
	// Hard block on raw grep/glob/read/edit: use ctx_* tools instead (saves context).
	"context_mode": {
		"enabled": true,
		"enforce": true,
		"blocked_tools": [
			"grep",
			"glob",
			"read",
			"edit",
			"write"
		]
	},
	// Applied config migrations. Managed by the plugin — don't touch.
	"_migrations": [
		"tasks_project_scope_default"
	],

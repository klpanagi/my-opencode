	"experimental": {
		"hashline_edit": true,
		"auto_resume": true,
		"preemptive_compaction": true,
		"task_system": true,
		"safe_hook_creation": true
	},
	"matrix_loop": {
		"enabled": true,
		"default_max_iterations": 100,
		"state_dir": ".opencode/"
	},
	"background_task": {
		"defaultConcurrency": 8,
		"messageStalenessTimeoutMs": 120000,
		"staleTimeoutMs": 180000,
		"circuitBreaker": {
			"enabled": true,
			"maxToolCalls": 75,
			"consecutiveThreshold": 10
		}
	},
	"tdd_enforcer": {
		"enabled": true
	},
	"browser_automation_engine": {
		"provider": "playwright"
	},
	"morpheus": {
		"tasks": {
			"scope": "project"
		}
	},
	"assembly": {
		"enabled": true,
		"providers": [
			{
				"providerID": "byteplus-plan",
				"modelID": "dola-seed-2.0-code"
			},
			{
				"providerID": "byteplus-plan",
				"modelID": "dola-seed-2.0-code"
			}
		],
		"default_voters": 3,
		"default_rounds": 2,
		"timeout_ms": 60000
	},
	"security": {},
	"runtime_fallback": {
		"enabled": true,
		"retry_on_errors": [
			429,
			500,
			502,
			503,
			504
		],
		"max_fallback_attempts": 3,
		"cooldown_seconds": 60,
		"timeout_seconds": 30,
		"notify_on_fallback": true
	},
	"matrixx_self_config": {
		"enabled": true,
		"proactive": false
	},
	"rtk": {
		"enabled": true,
		"binary_path": "/home/klpanagi/.local/bin/rtk",
		"timeout_ms": 5000
	},
	// ───────────────────────────────────────────────────────────────────────
	// Headroom — network-proxy compression (L4) — CacheAligner→ContentRouter→CCR
	// Enable/disable via `enabled` below + run `headroom wrap opencode`
	// Docs: https://github.com/headroomlabs-ai/headroom
	// Install: uv tool install headroom-ai[all]  or  pipx install headroom-ai[all]
	// Verify: headroom --version && headroom doctor
	// Example (disabled by default — uncomment to enable):
	// ───────────────────────────────────────────────────────────────────────
	// "headroom": {
	//   "enabled": true,
	//   "proxyUrl": "http://127.0.0.1:8787",
	//   "project": "my-project",
	//   "backend": "openai"
	// },
	// ───────────────────────────────────────────────────────────────────────
	// DCP — Dynamic Context Pruning (L3) — profile switcher
	// Install: add "@tarquinen/opencode-dcp" to opencode.jsonc plugin array
	// Switch: /dcp-profile [economy|balanced|performance|ultimate]
	// Docs: https://github.com/tarquinen/opencode-dcp
	// Enabled by default when plugin installed (true). Full config example:
	// See repo matrixx.example.jsonc for exhaustive DCP base/profiles example.
	// ───────────────────────────────────────────────────────────────────────
	// "dcp": {
	//   "enabled": true,
	//   "default_profile": "balanced",
	//   "base": {
	//     "autoUpdate": false,
	//     "debug": false,
	//     "pruneNotificationType": "chat",
	//     "compress": {
	//       "mode": "range",
	//       "permission": "allow",
	//       "showCompression": true,
	//       "summaryBuffer": true,
	//       "nudgeForce": "strong",
	//       "iterationNudgeThreshold": 5,
	//       "protectedTools": [],
	//       "protectUserMessages": false
	//     },
	//     "strategies": {
	//       "deduplication": { "enabled": true, "protectedTools": [] },
	//       "purgeErrors": { "enabled": true, "protectedTools": [] }
	//     },
	//     "commands": { "enabled": true, "protectedTools": [] },
	//     "manualMode": { "enabled": false, "automaticStrategies": true },
	//     "protectedFilePatterns": []
	//   }
	// },
	// ───────────────────────────────────────────────────────────────────────
	// context-mode — tool output sandboxing (L2) — FTS5 sandbox, ctx_* tools
	// External plugin: add "context-mode" to opencode.jsonc `plugin` array + this gate.
	// Matrixx auto-detects ctx_* tools and injects MUST discipline.
	//
	// ENABLING (default):
	//   1. opencode.jsonc: { "plugin": ["context-mode", "opencode-matrixx"] }
	//   2. matrixx.jsonc: { "context_mode": { "enabled": true } }  ← default true, omit to keep enabled
	//   3. Restart OpenCode. Verify via `ctx stats` or `bunx opencode-matrixx doctor`
	//
	// DISABLING:
	//   - Soft (keep plugin): { "context_mode": { "enabled": false } }
	//   - Hard (remove plugin): remove "context-mode" from opencode.jsonc `plugin` array
	//   - Per-hook: { "disabled_hooks": ["context-mode-enforcer"] }
	//
	// ENFORCEMENT (hard block vs soft warn):
	//   { "context_mode": { "enabled": true, "enforce": true, "blocked_tools": ["grep","glob"] } }
	//   - enforce:false (default) → grep/glob/read warn via hook message (prompt says MUST)
	//   - enforce:true  → grep/glob throw/block, read/bash warn (edit chain exempt)
	//   - blocked_tools: tools to gate (default ["grep","glob"]; add "read","bash" to also cover those)
	//
	// Docs: https://github.com/mksglu/context-mode
	// Guide: docs/context-management.md#22-context-mode
	// ───────────────────────────────────────────────────────────────────────
	// Hide tools from the LLM entirely (top-level only -- context_mode strips
	// unknown keys, so nesting disabled_tools inside it is silently ignored).
	"disabled_tools": [
		"grep",
		"glob"
	],
	"context_mode": {
		"enabled": true,
		"enforce": true,
		"blocked_tools": [
			"grep",
			"glob",
			"read",
			"write"
		]
	},
	"_migrations": [
		"tasks_project_scope_default"
	]
}

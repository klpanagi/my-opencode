{
  // Balanced — recommended default, moderate aggression
  "pruneNotification": "minimal",
  "compress": {
    "maxContextLimit": "60%",
    "minContextLimit": "30%",
    "nudgeFrequency": 3,
    "nudgeForce": "strong",
    "iterationNudgeThreshold": 10
  },
  "turnProtection": {
    "enabled": true,
    "turns": 2
  },
  "experimental": {
    "allowSubAgents": true
  },
  "strategies": {
    "purgeErrors": {
      "turns": 2
    }
  }
}

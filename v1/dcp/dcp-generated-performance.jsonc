{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/v3.1.14/dcp.schema.json",
  "enabled": true,
  "autoUpdate": false,
  "debug": false,
  "pruneNotificationType": "chat",
  "compress": {
    "mode": "range",
    "permission": "allow",
    "showCompression": true,
    "summaryBuffer": true,
    "nudgeForce": "strong",
    "iterationNudgeThreshold": 12,
    "protectedTools": [],
    "protectUserMessages": false,
    "maxContextLimit": "80%",
    "minContextLimit": "35%",
    "nudgeFrequency": 4
  },
  "strategies": {
    "deduplication": {
      "enabled": true,
      "protectedTools": []
    },
    "purgeErrors": {
      "enabled": true,
      "protectedTools": [],
      "turns": 2
    }
  },
  "commands": {
    "enabled": true,
    "protectedTools": []
  },
  "manualMode": {
    "enabled": false,
    "automaticStrategies": true
  },
  "protectedFilePatterns": [],
  "pruneNotification": "minimal",
  "turnProtection": {
    "enabled": true,
    "turns": 3
  },
  "experimental": {
    "allowSubAgents": true
  }
}
